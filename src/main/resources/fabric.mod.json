{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "FarmHelper Fabric for Minecraft 26.3 — no Discord, no analytics.",
  "authors": [
    "JellyLabScripts",
    "BetterFarmHelper contributors",
    "Vvien18"
  ],
  "license": "Custom",
  "icon": "assets/farmhelperfabric/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.jelly.farmhelper.fabric.FarmHelperFabric"
    ],
    "client": [
      "com.jelly.farmhelper.fabric.FarmHelperFabricClient"
    ]
  },
  "mixins": [
    "farmhelperfabric.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
